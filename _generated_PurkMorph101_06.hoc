/**************************************************************/
t = 1
dt = 0.02
Vrest = -68
celsius = 37
tstop = 5

strdef outputfile, prefix
prefix = "DS2M0PurkVar2"

/***************************************************************/
strdef FCONN, FPATT
FPATT = "Weight/Pattern_nsLTD_NN1_14740_P100_S100_noise10_1.dat"
FCONN = "Weight/Weight_nsLTD_NN1_14740_P100_S100_noise10_1.dat"
//FCONN = "Weight/Weight_nsLTD_NN3_14740_P200_S100_noise10_7.dat"
 
objref fw, w
fw = new File(FCONN)
fw.ropen()
w = new Vector(14740)
w.scanf(fw)
fw.close()

objref fp, p
fp = new File(FPATT)
fp.ropen()
p = new Vector(14740)
nread_patterns = p.scanf(fp, 1, 300)
fp.close()
if (nread_patterns != 14740) {
    printf("ERROR: expected 14740 pattern entries, read %g. Check pattern column/count.\n", nread_patterns)
    quit()
}

membranecap = 1.64                                                // specific membrane capacitance in uF cm^-2
membraneresist = 30000                                            // specific membrane resistance in ohm cm^2 for dendrite
somamembraneresist = 10000
axialresist = 250                                                 // axial resistivity in ohm cm

forall {insert Leak el_Leak = -80 Ra=axialresist}
forsec "dend" {gl_Leak=1.0/membraneresist Ra=axialresist cm=1.0*membranecap}
forsec "soma" {gl_Leak=1/somamembraneresist Ra=axialresist cm=1.0*membranecap}

spine_dens = 13
spine_area = 1.33
spine_spacing = 0.7531                                            // um; gives 14740 explicit spines for this morphology

func explicit_spines() { local n
	n = int(L/spine_spacing + 0.5)
	if (n < 1) n = 1
	return n
}

func spinecomp() { local a
	maxdiam = 0
	for (x) if (diam(x) > maxdiam) maxdiam = diam(x)
	if (maxdiam <= 3.1701) {                                 // spine correction only for thin dendrites
		a = 0
		for(x) a=a+area(x)
		F = ((spine_area*(L*spine_dens-explicit_spines())) + a)/a
	} else {
		F = 1 // no spine correction for larger dendrites
	}
	return F
        print F
} 

proc add_spines() { 

		spinecomp()
		gl_Leak = spinecomp()/membraneresist
		cm = spinecomp()*membranecap
                 
}

forsec "dend" add_spines()

objref sl, sthick, Spine_Head, Spine_Neck
sl = new SectionList()
sthick = new SectionList()
Spine_Head = new SectionList()
Spine_Neck = new SectionList()

nDendrites = 1599
nsmallDend = 0
nlargeDend = 0
nspines = 0
i = 0

forsec "dend" {
      maxdiam = 0
      for (x) if (diam(x) > maxdiam) maxdiam = diam(x)
      if(maxdiam <= 3.1701) {
           sl.append()
           nsmallDend = nsmallDend + 1
           nspines = nspines + explicit_spines()

      } else {
           sthick.append()
           nlargeDend = nlargeDend+1
              }
}                             

create spine_neck[nspines]
create spine_head[nspines]

for i = 0, nspines-1 {
spine_neck[i].diam = 0.2
spine_neck[i].L = 0.66
}

for l = 0, nspines-1 {
spine_head[l].diam = 0.54
spine_head[l].L = 0.54
}


for j = 0, nspines-1 {
connect spine_head[j](0), spine_neck[j](1)
}


iii = 0
forsec sl {
   nsp_section = explicit_spines()
   for kkk = 0, nsp_section-1 {
       jjj = (kkk + 0.5)/nsp_section
       connect spine_neck[iii](0), jjj
       iii+=1
   }
}

for i = 0, nspines-1 spine_head[i] {
spine_head[i] Spine_Head.append()
}

for i = 0, nspines-1 spine_neck[i] {
spine_neck[i] Spine_Neck.append()
}

forsec Spine_Head {insert Leak el_Leak = -80 Ra=axialresist}
forsec Spine_Neck {insert Leak el_Leak = -80 Ra=axialresist}

forsec Spine_Head {gl_Leak=1.0/membraneresist Ra=axialresist cm=1.0*membranecap}
forsec Spine_Neck {gl_Leak=1.0/membraneresist Ra=axialresist cm=1.0*membranecap}

/********************************Excitatory Synapses in spines*****************/
objref syn[nspines]
objref stim[nspines]

a = 0 
n = 0
gg = 0.7
objref rnd
rnd = new Random()
y = 0  
forsec "spine_head"  for(x, 0){  

 surff = 0
 surff +=area(x)

 b = rnd.uniform(0, 1)*100
       if(p.x(n) == 0) {

            syn[a] = new Ampa_PC(0.5)
            syn[a].gmax = gg*surff
            stim[a] = new NetStim(0.5)
            stim[a].noise = 1
            stim[a].interval = 357.1                         // adjust firing frequency for the background excitation
            stim[a].number = 1900
            stim[a].start = 300+b

                       } else {

            syn[a] = new Ampa_PC(0.5)
            syn[a].gmax = 7*surff*w.x(n)
            stim[a] = new NetStim(0.5)
            stim[a].noise = 0
            stim[a].interval = 0
            stim[a].number = 1
            stim[a].start = 2000   
            y +=1

           }
          
           a+=1
           n = n+1


}  

objref nclist
nclist = new List()


nn = 0
mm = 0
objref netconExc[nspines]
for kr = 0, nspines-1 {
//netconExc[kr] = new NetCon(prelist.object(nn), postlist.object(mm))
netconExc[kr] = new NetCon(stim[kr], syn[kr])
netconExc[kr].threshold = 0
netconExc[kr].weight = 1
netconExc[kr].delay = 0
nclist.append(netconExc[kr])
nn +=1
mm +=1
} 

/********************************Inhibitory Synapses in spines*****************/
a = 0
b = 0

objref inhsyn[nsmallDend], inhsyn1[nlargeDend]
objref rr
rr = new Random()

a = 0
surf = 0
//forsec sl for(x) {surf += area(x)}
gmax = 7e-05
forsec sl for(x, 0) {
surf = 0
surf += area(x)
inhsyn[a] = new GABA(0.5)
inhsyn[a].gmax = gmax*surf*0.001
a+=1
}

surf1 = 0
//forsec sthick for(x) {surf1 += area(x)}
gmax1 = 1.4e-05
forsec sthick for(x, 0) {
surf1 = 0
surf1 += area(x)
inhsyn1[b] = new GABA(0.5)
inhsyn1[b].gmax = gmax1*surf1*0.001
b+=1
}


objref inhstim[nDendrites]
for i = 0, nDendrites-1 {
a =  rr.uniform(0, 1000)
inhstim[i] = new NetStim(0.5)
inhstim[i].number = 5000
inhstim[i].interval = 1
inhstim[i].noise = 1
inhstim[i].start = 700
}

bb = 0
cc = 0
objref netconinh[nDendrites] //, netconinh1[nlargeDend]
for i = nlargeDend, nDendrites-1 {
netconinh[i] = new NetCon(inhstim[i], inhsyn[cc])
netconinh[i].weight = 1
netconinh[i].threshold = 0
cc +=1
}

for i = 9, nlargeDend-1{
netconinh[i] = new NetCon(inhstim[i], inhsyn1[bb])
netconinh[i].weight = 1
netconinh[i].threshold = 0
bb +=1
}       

access soma
objectvar apc
soma {
    apc = new APCount(0.5)
}
apc.thresh = -20
apc.time = tstop 


objref outspikes_k_105
outspikes_k_105 = new Vector()
apc.record(outspikes_k_105)


/*************** insert active conductances  ***********/
shell_depth = 0.2 // um

soma {
insert NaF gnabar_NaF = 7.5
insert NaP gnabar_NaP= 0.001 // default is correct value for soma
//insert CaP gcabar_CaP = 0.0 // no P type Ca CAppointmenth in soma
insert CaT gcabar_CaT = 0.0005 // default is correct value for soma and dend
insert Kh1 gkbar_Kh1 = 0.0003 // default is correct value for soma, Ih uses only K ions here
insert Kh2 gkbar_Kh2 = 0.0003 // default is correct value for soma, Ih uses only K ions here
insert Kdr gkbar_Kdr = 0.6 // default is correct value for soma
insert KMnew2 gkbar_KMnew2 = 0.00004 // default is correct value for soma
insert KA gkbar_KA = 0.015 // default is correct value for soma
//insert KC gkbar_KC = 0.0 // no BK Ch in soma
//insert K2 gkbar_K2 = 0.0 // no KCa in soma
insert cad
equivalentDepth = shell_depth - shell_depth^2/diam
// GENESIS calculates shell area as (outer circle area - inner circle area)
// our calcium diffusion had used depth * outer circumference
depth_cad = equivalentDepth

cai = 4e-5 cao = 2.4
eca = 12.5*log(cao/cai)
ion_style("ca_ion", 1, 1, 0, 0, 0) // was ("ca_ion", 1, 1, 0, 1, 0)
ena = 45 // mV Na+ reversal potential
ek = -85 // mV K+ reversal potential
}

forsec "dend" {

/* gmax as in DeSchutter 1994 PM9 'rest of dendrite' */

//insert NaF gnabar_NaF = 0.0
//insert NaP gnabar_NaP = 0.0
insert CaP gcabar_CaP = 0.0045
insert CaT gcabar_CaT = 0.0005
//insert Kh1 gkbar_Kh1 = 0.0
//insert Kh2 gkbar_Kh2 = 0.0
//insert Kdr gkbar_Kdr = 0.0
insert KMnew2 gkbar_KMnew2 = 0.000013
//insert KA gkbar_KA = 0.0
insert KC gkbar_KC = 0.08
insert K2 gkbar_K2 = 0.00039
insert cad
equivalentDepth = shell_depth - shell_depth^2/diam
// GENESIS calculates shell area aNetStims (outer circle are - inner circle area)
// our calcium diffusion had used depth * outer circumference
depth_cad = equivalentDepth

cai = 4e-5 cao = 2.4
ion_style("ca_ion", 1, 1, 1, 1, 0) // was ("ca_ion", 1, 1, 0, 1, 0)
//ena = 45 // mV Na+ reversal potential
ek = -85 // mV K+ reversal potential
}

/* add (the same) conductences to main dend, the spine necks and spine heads*/

forsec md {
/* gmax as in DeSchutter 1994 PM9 'Main Dendrite'*/
//insert NaF gnabar_NaF = 0.0
//insert NaP gnabar_NaP = 0.0
insert CaP gcabar_CaP = 0.0045
insert CaT gcabar_CaT = 0.0005
//insert Kh1 gkbar_Kh1 = 0.0
//insert Kh2 gkbar_Kh2 = 0.0
insert Kdr gkbar_Kdr = 0.06
insert KMnew2 gkbar_KMnew2 = 0.000010
insert KA gkbar_KA = 0.002
insert KC gkbar_KC = 0.08
insert K2 gkbar_K2 = 0.00039
insert cad
equivalentDepth = shell_depth - shell_depth^2/diam
// GENESIS calculates shell area as (outer circle area - inner circle area)
// our calcium diffusion had used depth * outer circumference
depth_cad = equivalentDepth

cai = 4e-5 cao = 2.4
ion_style("ca_ion", 1, 1, 1, 1, 0) // was ("ca_ion", 1, 1, 0, 1, 0)
//ena = 45 // mV Na+ reversal potential
ek = -85 // mV K+ reversal potential
}

/*access soma
/*************** now insert current pulses and synapses *********/
access soma
	objectvar currentpulse

	currentpulse = new IClamp(0.5)       
	currentpulse.del = 100 
	currentpulse.dur = 1000
	currentpulse.amp = 0


/********************************************/
/***** initialization of simulation run *****/
/********************************************/

proc run() {
print currentpulse.amp

	// initialization of simulation run
	t = 0                   // simulation starts at t = 0 ms
	count = 0
	finitialize(Vrest)
	fcurrent()
       while (t < tstop) {
                fadvance()
        }



	// wopen() disabled for Python batch execution
}

/******* generate an IV *********/

proc metarun() {local myvar

	for(myvar = 1; myvar < 2; myvar = myvar + 1) {

		scalar=1.5*myvar
		currentpulse.amp = scalar
		
		if (scalar<=0) {
		sprint(outputfile, "%sm%g", prefix, -scalar)
		}
		if (scalar>0) {
		sprint(outputfile, "%sp%g", prefix, scalar)
		}
		wopen(outputfile)
		run()
	}
}

//metarun() 



 




 
